# Model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=home-security

# Camera
CAMERA_SOURCE=0                  # int = USB index, string = rtsp://... URL
FRAME_SAMPLE_INTERVAL=2          # seconds between samples
MOTION_PIXEL_THRESHOLD=500000    # pixel delta to trigger frame emit

# Identity
CONFIDENCE_THRESHOLD=0.80        # below this → treat as unknown

# Night mode window (24h)
UNKNOWN_ALERT_HOUR_START=22
UNKNOWN_ALERT_HOUR_END=6

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Home Assistant
HA_WEBHOOK_URL=
HA_ENABLED=false

# Paths
SNAPSHOT_DIR=./snapshots
LOG_PATH=./logs/events.jsonl
SKILL_PATH=./agent/skills/home_security.md
